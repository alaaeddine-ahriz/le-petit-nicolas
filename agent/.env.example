# Built-in agent (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-4.1-mini

# Exa web search + URL extract tools (https://dashboard.exa.ai)
EXA_API_KEY=

# Telegram channel (https://docs.copilotkit.ai/reference/channels/sdk/direct-adapters)
TELEGRAM_BOT_TOKEN=
CHANNEL_CODE=le-petit-nicolas
CPK_INTELLIGENCE_API_KEY=

# Supabase (data/ owns the schema — see ../data/README.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only (bypasses RLS) — never expose to the browser.
# RLS is on with no policies, so this is the only key that can read/write.
SUPABASE_SERVICE_ROLE_KEY=

# Fathom MCP (post-call transcripts) — read by src/agent/insights.ts
FATHOM_MCP_URL=http://localhost:8420/
FATHOM_MCP_API_KEY=

PORT=3000
