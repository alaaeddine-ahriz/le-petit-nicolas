# Le Petit Nicolas — environment variables
# Copy this file to .env and fill in the real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Fathom (post-call meeting transcript, via MCP) ---
FATHOM_API_KEY=

# --- Telegram (grammY bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLASS_GROUP_CHAT_ID=

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
